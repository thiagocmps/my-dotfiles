{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "plugins": [
    {
      "package": "./vendor/ponytail",
      "options": {
        "skipProviders": [
          "ollama"
        ],
        "skipModels": [],
        "skipAgents": []
      }
    },
    "opencode-snip@latest"
  ],
  "providers": {
    "ollama": {
      // Ollama's OpenAI endpoint only disables thinking with this value.
      "body": {
        "reasoning_effort": "none"
      }
    },
    "openrouter": {
      "models": {
        "openrouter/free": {
          "name": "OpenRouter Free (Auto)"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "wordcraft": {
        "type": "local",
        "command": [
          "/home/thiago/.local/bin/wordcraft-cli",
          "mcp"
        ],
        "disabled": true
      },
      "drawio-hosted": {
        "type": "remote",
        "url": "https://mcp.draw.io/mcp",
        "disabled": true
      }
    }
  }
}
